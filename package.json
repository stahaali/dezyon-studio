{
  "name": "dezyon-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/clean-dev.js && next dev",
    "dev:force": "node scripts/clean-dev.js && next dev --port 3000",
    "clean:dev": "node scripts/clean-dev.js",
    "prebuild": "node scripts/clean-build.js && node scripts/sync-api-config.js",
    "build:clean": "node scripts/clean-build.js && npm run build",
    "build": "node scripts/strip-dev-api.js --remove && node scripts/build-static.js && node scripts/strip-dev-api.js --restore",
    "postbuild": "node scripts/sync-api-config.js && node scripts/write-build-info.js",
    "build:hostinger": "npm run build",
    "build:vercel": "next build",
    "package:hostinger": "npm run build && node scripts/package-out.js",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "@fontsource/lexend": "^5.2.11",
    "@vapi-ai/web": "^2.5.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "mysql2": "^3.22.5",
    "next": "16.2.7",
    "nodemailer": "^8.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-google-recaptcha": "^3.1.0",
    "recharts": "^3.8.1",
    "simli-client": "^3.0.1",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
